<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BrawlInstaller.Views"
             xmlns:resources="clr-namespace:BrawlInstaller.Resources"
             xmlns:userControls="clr-namespace:BrawlInstaller.UserControls"
             xmlns:behaviors="clr-namespace:BrawlInstaller.Behaviors"
             xmlns:i="clr-namespace:Avalonia.Interactivity;assembly=Avalonia.Base"
             x:Class="BrawlInstaller.Views.FilesView">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Compare Files" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Label x:Name="leftFileLabel" Content="Left File:"/>
                        <userControls:FileBox x:Name="leftFileBox" TextBoxWidth="300" Text="{Binding LeftFilePath}" Grid.Column="1"/>

                        <Label x:Name="rightFileLabel" Content="Right File:" Grid.Row="1"/>
                        <userControls:FileBox x:Name="rightFileBox" TextBoxWidth="300" Text="{Binding RightFilePath}" Grid.Row="1" Grid.Column="1"/>

                        <StackPanel Grid.Row="2">
                            <Button x:Name="compareButton" Content="Compare" Command="{Binding CompareFilesCommand}" IsEnabled="{Binding FilePathsEnabled}"/>
                            <Button x:Name="openButton" Content="Browse..." Command="{Binding OpenFilePatchCommand}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </GroupBox>

            <GroupBox Header="Build Patch" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="buildFileListBox"
                                 Items="{Binding BuildFilePatches}"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 MinHeight="120"
                                 SelectedItem="{Binding SelectedBuildFilePatch}"
                                 DisplayMemberPath="TargetPath"/>
                        <StackPanel Grid.Column="1">
                            <Button x:Name="addBuildPatchFilesButton" Content="+" Style="{StaticResource miniButton}" Command="{Binding AddBuildPatchEntryCommand}"/>
                            <Button x:Name="removeBuildPatchFilesButton" Content="-" Style="{StaticResource miniButton}" Command="{Binding RemoveBuildPatchEntryCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="buildFileBrowseButton" Content="Browse..." Command="{Binding OpenBuildPatchCommand}"/>

                    <Grid Visibility="{Binding SelectedBuildFilePatch, Converter={StaticResource nullVisConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Search for the file at this location..." Grid.ColumnSpan="2"/>
                        <Label Content="Path:" Grid.Row="1"/>
                        <TextBox Grid.Column="1" Grid.Row="1" Text="{Binding SelectedBuildFilePatch.TargetPath}" Width="300"/>
                        <TextBlock Text="If the file is found, apply this patch..." Grid.Row="2" Grid.ColumnSpan="2"/>
                        <Label Content="Patch File:" Grid.Row="3"/>
                        <userControls:FileBox x:Name="patchFileBox" TextBoxWidth="300" Text="{Binding SelectedBuildFilePatch.FilePatchPath}" Grid.Column="1" Grid.Row="3"/>
                        <TextBlock Text="If file is not found or there's no patch, install this file..." Grid.Row="4" Grid.ColumnSpan="2"/>
                        <Label Content="File:" Grid.Row="5"/>
                        <userControls:FileBox x:Name="fileBox" TextBoxWidth="300" Text="{Binding SelectedBuildFilePatch.FilePath}" Grid.Column="1" Grid.Row="5"/>
                        <CheckBox Content="Overwrite file if it exists" Grid.Row="6" Grid.ColumnSpan="2" IsChecked="{Binding SelectedBuildFilePatch.OverwriteIfFileExists}"/>
                    </Grid>

                    <Button x:Name="buildFileExportButton" Content="Save as..." Command="{Binding ExportBuildPatchCommand}"/>
                    <Button x:Name="applyBuildFileButton" Content="Apply to Build" Command="{Binding ApplyBuildPatchCommand}" IsEnabled="{Binding BuildSettingsExist}"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <Separator Grid.Column="1" HorizontalAlignment="Left">
            <Separator.RenderTransform>
                <RotateTransform Angle="90"/>
            </Separator.RenderTransform>
        </Separator>

        <Grid Grid.Column="1" Margin="3,0,0,0" Visibility="{Binding FilePatch, Converter={StaticResource nullVisConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="scrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Changes" Height="{Binding ElementName=scrollViewer, Path=ViewportHeight}">
                        <ContentControl Style="{StaticResource resizeContainer}" MinWidth="140">
                            <TreeView x:Name="treeView" Items="{Binding NodeList}">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding IsEnabled}"/>
                                            <Image Source="{Binding NodeDef.ResourceType, Converter={StaticResource nodeUriStringConverter}}" Width="16" Height="16"/>
                                            <TextBlock Text="{Binding NodeDef.Symbol}"/>
                                            <TextBlock Text="{Binding NodeDef.Name}"/>
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </ContentControl>
                    </GroupBox>

                    <GroupBox Header="Node Info" Visibility="{Binding SelectedNode, Converter={StaticResource nullVisConverter}}" Grid.Column="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Content="Name:"/>
                            <Label Content="{Binding SelectedNode.NodeDef.Name}" Grid.Column="1" HorizontalAlignment="Left"/>
                            <Label Content="Type:" Grid.Row="1"/>
                            <Label Content="{Binding SelectedNode.NodeDef.TypeName}" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"/>
                            <Label Content="Status:" Grid.Row="2"/>
                            <Label Content="{Binding SelectedNode.NodeDef.Change}" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"/>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2">
                                <CheckBox IsChecked="{Binding SelectedNode.NodeDef.ForceAdd}" Content="Force Add" Visibility="{Binding SelectedNode.AllowForceAdd, Converter={StaticResource boolVisConverter}}"/>
                                <CheckBox IsChecked="{Binding SelectedNode.NodeDef.ReplaceAllContents}" Content="Replace All Contents" Visibility="{Binding SelectedNode.AllowReplaceAllContents, Converter={StaticResource boolVisConverter}}"/>
                                <Image Height="128" Width="128" Source="{Binding SelectedNode.NodeDef.Image}"/>
                                <TextBlock Text="{Binding SelectedNode.NodeDef.GroupName, StringFormat=Color smashed with {0}}" Visibility="{Binding SelectedNode.NodeDef.GroupName, Converter={StaticResource stringVisConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </ScrollViewer>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Label Content="Target File:"/>
                    <userControls:FileBox Text="{Binding TargetFilePath}" Filter="{Binding FileFilter}" TextBoxWidth="300"/>
                </WrapPanel>

                <WrapPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                    <Button Content="Save as..." Command="{Binding ExportFilePatchCommand}"/>
                    <Button Content="Apply to Target" Command="{Binding ApplyFilePatchCommand}" IsEnabled="{Binding TargetFilePath, Converter={StaticResource emptyStringBoolConverter}}"/>
                </WrapPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>